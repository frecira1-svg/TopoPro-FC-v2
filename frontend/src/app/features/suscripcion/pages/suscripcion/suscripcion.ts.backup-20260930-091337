          this.contexto =
            contexto;

          this.cargando =
            false;

          this.cdr.detectChanges();

        },

        error: (error) => {

          console.error(
            'ERROR OBTENIENDO CONTEXTO COMERCIAL:',
            error
          );

          this.cargando =
            false;

          this.error =
            error?.error?.error ||
            'No fue posible consultar el estado de tu suscripciÃ³n.';

          this.cdr.detectChanges();

