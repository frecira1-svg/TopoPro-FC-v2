  // ==========================================================
  // LIMPIAR URL
  // ==========================================================

  private limpiarParametrosURL(): void {

    try {

      const url =
        new URL(
          window.location.href
        );


      [
        'preapproval_id',
        'status',
        'collection_status',
        'payment_id'
      ].forEach(
        (parametro) => {

          url.searchParams.delete(
            parametro
          );

        }
      );


      window.history.replaceState(
        {},
        document.title,
        url.pathname +
        (
          url.search
            ? url.search
            : ''
        )
      );

    } catch (error) {

      console.warn(
        'No fue posible limpiar la URL:',
        error
      );

    }

  }

